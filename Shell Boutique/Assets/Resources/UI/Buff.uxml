<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Buff" class="Buff" style="flex-grow: 0; height: 100%; aspect-ratio: 0.6666667; border-top-left-radius: 33px; border-top-right-radius: 33px; border-bottom-right-radius: 33px; border-bottom-left-radius: 33px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; padding-top: 3%; padding-right: 3%; padding-bottom: 3%; padding-left: 3%; align-items: center; justify-content: flex-start;">
        <ui:Label text="As Fast as a Snail" name="Title" style="height: 20%; width: 100%; margin-bottom: 12%; font-size: 38%; -unity-text-align: upper-center; -unity-font-style: bold; white-space: pre-wrap;"/>
        <ui:Label text="Label" name="Description" style="font-size: 24%; height: 50%; -unity-text-align: upper-center; white-space: pre-wrap;"/>
        <ui:Label text="10% Increased Movement Speed" name="Effect" style="font-size: 22%; white-space: pre-wrap; -unity-text-align: middle-center; color: rgb(54, 123, 39); margin-top: 4%;"/>
    </ui:VisualElement>
</ui:UXML>
